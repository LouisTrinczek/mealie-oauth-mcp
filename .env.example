MEALIE_URL=https://mealie.example.com
PUBLIC_URL=https://mcp.example.com

# Preferred: ENCRYPTION_KEYS_FILE with a Docker secret (see deploy/docker-compose.example.yml).
# Generate the secret file content with: echo "k1:$(openssl rand -base64 32)"
# ENCRYPTION_KEYS=k1:<base64-of-32-random-bytes>

# LOG_LEVEL=info
# LOG_FORMAT=json
# SESSION_MAX_AGE=720h
# ACCESS_TOKEN_TTL=1h

# Required behind a reverse proxy: the CIDR your proxy connects from (for
# example the Docker network subnet). Without it every user shares the proxy's
# rate limit for logins and token refreshes.
TRUSTED_PROXIES=172.18.0.0/16
